# ---------------------------------------------------------------------------
# Studioz D — frontend environment. Copy to `.env.local` and fill in.
# Every VITE_* value is PUBLIC (it ships inside the JS bundle).
# Never put a private API secret here.
# ---------------------------------------------------------------------------

# Canonical site origin, no trailing slash. Used for canonical URLs, OG tags
# and the generated sitemap.
VITE_SITE_URL=https://studiozd.com

# --- EmailJS (frontend-only enquiry delivery) ------------------------------
# Create a service + template at https://dashboard.emailjs.com
# The public key is designed to be exposed client-side.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Contact channels ------------------------------------------------------
# WhatsApp number in full international format, digits only (e.g. 919876543210)
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# --- Social / business profiles (full URLs) --------------------------------
VITE_INSTAGRAM_URL=
VITE_GOOGLE_BUSINESS_URL=
VITE_YOUTUBE_URL=

# --- Business address (leave blank to omit LocalBusiness structured data) --
VITE_BUSINESS_STREET=
VITE_BUSINESS_LOCALITY=
VITE_BUSINESS_REGION=
VITE_BUSINESS_POSTAL_CODE=
VITE_BUSINESS_COUNTRY=

# --- Analytics -------------------------------------------------------------
VITE_GA4_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_GSC_VERIFICATION=

# --- Admin demo gate -------------------------------------------------------
# Frontend-only demo gate for /admin. This is NOT security — it keeps the
# dashboard out of casual view until a real auth provider is wired in.
VITE_ADMIN_DEMO_PASSCODE=studiozd-demo
